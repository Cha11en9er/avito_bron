# Скопируйте в .env в корне проекта (файл .env в репозиторий не попадает).

# Путь к JSON ключу сервисного аккаунта (от каталога со скриптами):
GOOGLE_CREDENTIALS_JSON=service_account.json

# ID таблицы из URL: .../spreadsheets/d/ЭТОТ_ID/edit
# Необязательно, если подходит таблица по умолчанию в avito_google_sheet.py
# AVITO_GOOGLE_SHEET_ID=

# Очередь и запись в Google Таблицу (1). Без флага включается автоматически, если есть service_account.json
AVITO_GOOGLE_SHEET=1
